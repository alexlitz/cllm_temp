// -----------------------------------------------------------------------------
// CORPUS-SCOPED C90 libc for the c90_e2e broad-conformance harness.
//
// This file is appended by transpiler_harness.py (alongside src/stdlib/memory.c4)
// ONLY when running the broad C90 corpus.  It is NOT part of the shared c4 build
// stdlib and is NOT linked into the Doom build (Doom supplies its own strcpy/
// strcmp/etc. via id_port/doom_libc.c).  Scoping it to the harness keeps the
// Doom byte-exact path untouched (golden 174ece66 unchanged).
//
// It provides the standard C90 library functions the c-testsuite cases call that
// are NOT already defined by memory.c4 (which supplies malloc/free/memset/memcmp).
// Do NOT redefine malloc/free/memset/memcmp here -- memory.c4 owns them and a
// duplicate definition is a compile error.
//
// The c4 word is 64-bit; `int` and pointers are one word.  These implementations
// are byte-faithful to gcc -m32 for the observable (return value / buffer bytes /
// stdout via the surrounding printf), which is all the harness compares.
// -----------------------------------------------------------------------------

// ---- <stdlib.h> --------------------------------------------------------------

// abort(): the c-torture suite calls abort() on a self-check FAILURE.  gcc's
// libc abort() raises SIGABRT -> the process exits with code 134 (128+6).  The
// c4 VM has no signal delivery, so we emulate the OBSERVABLE (exit 134) via the
// exit syscall.  A byte-EXACT port never reaches abort() on a passing case, so
// this only fires when the port genuinely diverges (correctly a FAIL), and it
// makes the failing-case exit code match the gcc oracle's 134.
int abort() {
    exit(134);
    return 0;
}

// calloc(nmemb, size): allocate nmemb*size bytes, zero-initialised.
int calloc(int nmemb, int size) {
    int total;
    int ptr;
    char *p;
    int i;

    total = nmemb * size;
    if (total <= 0) {
        return 0;
    }
    ptr = malloc(total);
    if (ptr == 0) {
        return 0;
    }
    p = (char *)ptr;
    i = 0;
    while (i < total) {
        *p = 0;
        p = p + 1;
        i = i + 1;
    }
    return ptr;
}

// realloc(ptr, size): bump-allocator realloc -- allocate a fresh block and copy.
// The old size is unknown to a bump allocator, so copy `size` bytes (safe upper
// bound for a grow; for a shrink the extra copy is harmless as the caller only
// reads `size`).  ptr==0 behaves like malloc.
int realloc(int ptr, int size) {
    int np;
    char *d;
    char *s;
    int i;

    if (size <= 0) {
        return 0;
    }
    np = malloc(size);
    if (np == 0) {
        return 0;
    }
    if (ptr == 0) {
        return np;
    }
    d = (char *)np;
    s = (char *)ptr;
    i = 0;
    while (i < size) {
        *d = *s;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    return np;
}

// abs / labs: absolute value (labs is identical on a single-word VM).
int abs(int x) {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

int labs(int x) {
    if (x < 0) {
        return 0 - x;
    }
    return x;
}

// <ctype.h> classifiers (C locale).  Each takes an int (a char value or EOF) and
// returns non-zero if the character is in the class.  Provided here because the
// c-testsuite cases call them and memory.c4 does not.
int isdigit(int c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}
int isupper(int c) {
    if (c >= 65 && c <= 90) { return 1; }
    return 0;
}
int islower(int c) {
    if (c >= 97 && c <= 122) { return 1; }
    return 0;
}
int isalpha(int c) {
    if (isupper(c) || islower(c)) { return 1; }
    return 0;
}
int isalnum(int c) {
    if (isalpha(c) || isdigit(c)) { return 1; }
    return 0;
}
int isxdigit(int c) {
    if (isdigit(c)) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    return 0;
}
int isspace(int c) {
    if (c == 32 || (c >= 9 && c <= 13)) { return 1; }
    return 0;
}
int iscntrl(int c) {
    if ((c >= 0 && c <= 31) || c == 127) { return 1; }
    return 0;
}
int isprint(int c) {
    if (c >= 32 && c <= 126) { return 1; }
    return 0;
}
int isgraph(int c) {
    if (c >= 33 && c <= 126) { return 1; }
    return 0;
}
int ispunct(int c) {
    if (isgraph(c) && !isalnum(c)) { return 1; }
    return 0;
}
int toupper(int c) {
    if (islower(c)) { return c - 32; }
    return c;
}
int tolower(int c) {
    if (isupper(c)) { return c + 32; }
    return c;
}

// atoi: parse a leading optional-sign decimal integer.
int atoi(char *s) {
    int sign;
    int val;
    char *p;
    int c;

    p = s;
    sign = 1;
    val = 0;
    // skip leading whitespace (space, tab, newline, cr, vtab, formfeed)
    while (*p == 32 | *p == 9 | *p == 10 | *p == 13 | *p == 11 | *p == 12) {
        p = p + 1;
    }
    if (*p == 45) {          // '-'
        sign = 0 - 1;
        p = p + 1;
    } else if (*p == 43) {   // '+'
        p = p + 1;
    }
    while (1) {
        c = *p;
        if (c < 48 | c > 57) {
            return sign * val;
        }
        val = val * 10 + (c - 48);
        p = p + 1;
    }
    return sign * val;
}

// ---- <string.h> --------------------------------------------------------------

int strlen(char *s) {
    char *p;
    p = s;
    while (*p != 0) {
        p = p + 1;
    }
    return (int)p - (int)s;
}

int strcpy(char *dst, char *src) {
    char *d;
    char *s;
    d = dst;
    s = src;
    while (*s != 0) {
        *d = *s;
        d = d + 1;
        s = s + 1;
    }
    *d = 0;
    return (int)dst;
}

// strncpy: copy at most n bytes; if src is shorter, pad the rest with NUL.
int strncpy(char *dst, char *src, int n) {
    char *d;
    char *s;
    int i;
    d = dst;
    s = src;
    i = 0;
    while (i < n & *s != 0) {
        *d = *s;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    while (i < n) {
        *d = 0;
        d = d + 1;
        i = i + 1;
    }
    return (int)dst;
}

int strcat(char *dst, char *src) {
    char *d;
    char *s;
    d = dst;
    while (*d != 0) {
        d = d + 1;
    }
    s = src;
    while (*s != 0) {
        *d = *s;
        d = d + 1;
        s = s + 1;
    }
    *d = 0;
    return (int)dst;
}

// strcmp: signed byte compare (unsigned-char semantics via & 0xFF).
int strcmp(char *a, char *b) {
    char *p;
    char *q;
    int ca;
    int cb;
    p = a;
    q = b;
    while (1) {
        ca = *p & 255;
        cb = *q & 255;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        p = p + 1;
        q = q + 1;
    }
    return 0;
}

int strncmp(char *a, char *b, int n) {
    char *p;
    char *q;
    int ca;
    int cb;
    int i;
    p = a;
    q = b;
    i = 0;
    while (i < n) {
        ca = *p & 255;
        cb = *q & 255;
        if (ca != cb) {
            return ca - cb;
        }
        if (ca == 0) {
            return 0;
        }
        p = p + 1;
        q = q + 1;
        i = i + 1;
    }
    return 0;
}

// strchr: return pointer to first occurrence of c (as char), or 0.  A search for
// 0 matches the terminating NUL (per C90).
int strchr(char *s, int c) {
    char *p;
    int ch;
    p = s;
    ch = c & 255;
    while (1) {
        if ((*p & 255) == ch) {
            return (int)p;
        }
        if (*p == 0) {
            return 0;
        }
        p = p + 1;
    }
    return 0;
}

// strrchr: return pointer to LAST occurrence of c, or 0.
int strrchr(char *s, int c) {
    char *p;
    int ch;
    int last;
    p = s;
    ch = c & 255;
    last = 0;
    while (1) {
        if ((*p & 255) == ch) {
            last = (int)p;
        }
        if (*p == 0) {
            return last;
        }
        p = p + 1;
    }
    return last;
}

// memcpy: copy n bytes forward (dst/src assumed non-overlapping, per C90).
int memcpy(int dst, int src, int n) {
    char *d;
    char *s;
    int i;
    d = (char *)dst;
    s = (char *)src;
    i = 0;
    while (i < n) {
        *d = *s;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    return dst;
}

// memmove: overlap-safe copy (copy backward when dst is above src).
int memmove(int dst, int src, int n) {
    char *d;
    char *s;
    int i;
    if (dst == src | n <= 0) {
        return dst;
    }
    if (dst < src) {
        d = (char *)dst;
        s = (char *)src;
        i = 0;
        while (i < n) {
            *d = *s;
            d = d + 1;
            s = s + 1;
            i = i + 1;
        }
    } else {
        i = n;
        while (i > 0) {
            i = i - 1;
            *((char *)(dst + i)) = *((char *)(src + i));
        }
    }
    return dst;
}

// memchr: scan the first n bytes of s for byte c; return a pointer to it, or 0.
int memchr(int s, int c, int n) {
    char *p;
    int ch;
    int i;
    p = (char *)s;
    ch = c & 255;
    i = 0;
    while (i < n) {
        if ((*p & 255) == ch) {
            return (int)p;
        }
        p = p + 1;
        i = i + 1;
    }
    return 0;
}

// strstr: find the first occurrence of substring needle in haystack, or 0.  An
// empty needle matches at the start (per C90).
int strstr(char *hay, char *needle) {
    char *h;
    char *n;
    char *hh;
    char *nn;
    if (*needle == 0) {
        return (int)hay;
    }
    h = hay;
    while (*h != 0) {
        hh = h;
        nn = needle;
        while (*nn != 0 && (*hh & 255) == (*nn & 255)) {
            hh = hh + 1;
            nn = nn + 1;
        }
        if (*nn == 0) {
            return (int)h;
        }
        h = h + 1;
    }
    return 0;
}

// strncat: append at most n bytes of src to dst, NUL-terminate.
int strncat(char *dst, char *src, int n) {
    char *d;
    char *s;
    int i;
    d = dst;
    while (*d != 0) {
        d = d + 1;
    }
    s = src;
    i = 0;
    while (i < n && *s != 0) {
        *d = *s;
        d = d + 1;
        s = s + 1;
        i = i + 1;
    }
    *d = 0;
    return (int)dst;
}

// strspn: length of the initial segment of s consisting only of bytes in accept.
int strspn(char *s, char *accept) {
    char *p;
    char *a;
    int found;
    p = s;
    while (*p != 0) {
        a = accept;
        found = 0;
        while (*a != 0) {
            if ((*a & 255) == (*p & 255)) { found = 1; }
            a = a + 1;
        }
        if (found == 0) {
            return (int)p - (int)s;
        }
        p = p + 1;
    }
    return (int)p - (int)s;
}

// strcspn: length of the initial segment of s consisting of bytes NOT in reject.
int strcspn(char *s, char *reject) {
    char *p;
    char *r;
    p = s;
    while (*p != 0) {
        r = reject;
        while (*r != 0) {
            if ((*r & 255) == (*p & 255)) {
                return (int)p - (int)s;
            }
            r = r + 1;
        }
        p = p + 1;
    }
    return (int)p - (int)s;
}

// strpbrk: pointer to the first byte of s that is in accept, or 0.
int strpbrk(char *s, char *accept) {
    char *p;
    char *a;
    p = s;
    while (*p != 0) {
        a = accept;
        while (*a != 0) {
            if ((*a & 255) == (*p & 255)) {
                return (int)p;
            }
            a = a + 1;
        }
        p = p + 1;
    }
    return 0;
}

// mempcpy: like memcpy but returns dst + n (a pointer PAST the last byte copied).
int mempcpy(int dst, int src, int n) {
    memcpy(dst, src, n);
    return dst + n;
}

// ---- <stdio.h> ---------------------------------------------------------------

// puts: write a string + newline to stdout, return a non-negative value.
int puts(char *s) {
    char *p;
    p = s;
    while (*p != 0) {
        putchar(*p);
        p = p + 1;
    }
    putchar(10);
    return 0;
}

// -- sprintf helpers ----------------------------------------------------------
// __c4_num_digits: number of decimal digits in a non-negative value (>=1).
int __c4_num_digits(int val) {
    int n;
    if (val == 0) {
        return 1;
    }
    n = 0;
    while (val > 0) {
        val = val / 10;
        n = n + 1;
    }
    return n;
}

// __c4_put_uint: write the decimal digits of a non-negative value into buf
// most-significant-first (no sign, no padding), return the count written.
// Uses no local array (the c4 subset has no local array declarations): it peels
// digits from the top via a running power-of-ten divisor.
int __c4_put_uint(char *buf, int val) {
    int digits;
    int div;
    int i;
    int d;
    digits = __c4_num_digits(val);
    // build the largest divisor <= 10^(digits-1)
    div = 1;
    i = 1;
    while (i < digits) {
        div = div * 10;
        i = i + 1;
    }
    i = 0;
    while (i < digits) {
        d = (val / div) % 10;
        buf[i] = 48 + d;
        div = div / 10;
        i = i + 1;
    }
    return digits;
}

// sprintf: format into buf.  Supports the C90 conversions the corpus uses:
//   %d %i  (optional '0' flag + width), %u, %x %X, %c, %s, %%.
// Returns the number of characters written (excluding the NUL), like C sprintf.
//
// c4 has no user varargs and the c4 ABI addresses params by a FIXED offset that
// depends on the DEFINITION's param count -- so a callee's param count must
// equal the call site's arg count or the offsets desync.  The corpus exercises
// sprintf with exactly ONE value arg (sprintf(buf, fmt, val)), so this is
// defined with exactly THREE params to match that ABI; a format that consumes
// more than one value arg is out of scope for the corpus.
int sprintf(char *buf, char *fmt, int a3) {
    char *out;
    char *f;
    int ai;
    int c;
    int zero;
    int width;
    int arg;
    int digits;
    int k;
    int pad;
    char *sp;

    out = buf;
    f = fmt;
    ai = 0;
    while (*f != 0) {
        c = *f & 255;
        if (c != 37) {                 // not '%': copy literally
            *out = c;
            out = out + 1;
            f = f + 1;
        } else {
            f = f + 1;                 // consume '%'
            zero = 0;
            width = 0;
            // flags: only '0' is honoured (corpus uses %02d)
            while (*f == 48) {         // '0'
                zero = 1;
                f = f + 1;
            }
            // width digits
            while ((*f & 255) >= 48 & (*f & 255) <= 57) {
                width = width * 10 + ((*f & 255) - 48);
                f = f + 1;
            }
            // length modifiers (l/h/L etc.) ignored
            while (*f == 108 | *f == 104 | *f == 76) {
                f = f + 1;
            }
            c = *f & 255;
            f = f + 1;
            if (c == 37) {             // %%
                *out = 37;
                out = out + 1;
            } else {
                // fetch positional arg (corpus sprintf takes a single value arg)
                arg = a3;
                ai = ai + 1;

                if (c == 100 | c == 105) {     // d / i (signed)
                    if (arg < 0) {
                        *out = 45;             // '-'
                        out = out + 1;
                        arg = 0 - arg;
                    }
                    digits = __c4_num_digits(arg);
                    pad = width - digits;
                    while (pad > 0) {
                        if (zero == 1) { *out = 48; } else { *out = 32; }
                        out = out + 1;
                        pad = pad - 1;
                    }
                    out = out + __c4_put_uint(out, arg);
                } else if (c == 117) {         // u (unsigned; single-word)
                    digits = __c4_num_digits(arg);
                    pad = width - digits;
                    while (pad > 0) {
                        if (zero == 1) { *out = 48; } else { *out = 32; }
                        out = out + 1;
                        pad = pad - 1;
                    }
                    out = out + __c4_put_uint(out, arg);
                } else if (c == 99) {          // c
                    *out = arg & 255;
                    out = out + 1;
                } else if (c == 115) {         // s
                    sp = (char *)arg;
                    digits = 0;
                    while (sp[digits] != 0) {
                        digits = digits + 1;
                    }
                    pad = width - digits;
                    while (pad > 0) {
                        *out = 32;
                        out = out + 1;
                        pad = pad - 1;
                    }
                    k = 0;
                    while (k < digits) {
                        *out = sp[k];
                        out = out + 1;
                        k = k + 1;
                    }
                } else {                       // unknown: emit literally
                    *out = 37;
                    out = out + 1;
                    *out = c;
                    out = out + 1;
                }
            }
        }
    }
    *out = 0;
    return (int)out - (int)buf;
}

// snprintf: for the corpus, buffers are always large enough, so route to sprintf
// (ignoring the size bound).  Returns the char count sprintf produced.  Defined
// with FOUR params (buf, size, fmt, val) to match a single-value-arg call under
// the fixed-offset c4 ABI.
int snprintf(char *buf, int size, char *fmt, int a4) {
    return sprintf(buf, fmt, a4);
}

// alloca(n): the c-torture cases use __builtin_alloca / a bare alloca() for a
// scratch block that is only written/read within the calling function; a bump-
// heap malloc gives the same observable (the per-scope leak is invisible to a
// single-frame test).  n<=0 returns a valid distinct pointer.
int alloca(int n) {
    if (n <= 0) { n = 1; }
    return malloc(n);
}

// -----------------------------------------------------------------------------
// GNU-builtin support helpers (used by transpile.lower_gnu_builtins).
//
// These back __builtin_clz / _ctz / _popcount / _ffs / _parity and the checked-
// arithmetic __builtin_{add,sub,mul}_overflow lowerings.  They are word-exact
// for the COMBINED 32-BIT machine (compiler32 WORD=4 + c4vm32u): the ALU masks
// results to 32 bits and `>>` is an ARITHMETIC (sign-propagating) shift, so we
// mask each step to stay logical.  Not linked into Doom (corpus-scoped file).
// -----------------------------------------------------------------------------

// popcount(x): count set bits in the low 32 of x.  Bit-at-a-time so the
// arithmetic `>>` never leaks sign bits (we AND the low bit off first).
int __c4_popcount(int x) {
    int n;
    int i;
    n = 0;
    i = 0;
    while (i < 32) {
        n = n + (x & 1);
        x = (x >> 1) & 0x7fffffff;   // logical shift: clear the shifted-in sign
        i = i + 1;
    }
    return n;
}

// parity(x): popcount(x) & 1.
int __c4_parity(int x) {
    return __c4_popcount(x) & 1;
}

// clz(x): count leading zero bits (from bit 31 down).  Undefined for x==0 in
// gcc; the c-torture cases never call it with 0 on the taken path, but we return
// 32 for 0 defensively.
int __c4_clz(int x) {
    int n;
    int mask;
    if (x == 0) { return 32; }
    n = 0;
    mask = 0x80000000;
    while ((x & mask) == 0) {
        n = n + 1;
        mask = (mask >> 1) & 0x7fffffff;
        if (mask == 0) { return 32; }
    }
    return n;
}

// ctz(x): count trailing zero bits (from bit 0 up).  Undefined for x==0 in gcc;
// return 32 for 0 defensively.
int __c4_ctz(int x) {
    int n;
    if (x == 0) { return 32; }
    n = 0;
    while ((x & 1) == 0) {
        n = n + 1;
        x = (x >> 1) & 0x7fffffff;
    }
    return n;
}

// ffs(x): 1 + index of least-significant set bit, or 0 if x==0.
int __c4_ffs(int x) {
    if (x == 0) { return 0; }
    return __c4_ctz(x) + 1;
}

// ---- checked arithmetic: __builtin_{add,sub,mul}_overflow ------------------
// Two families, chosen by transpile-time destination signedness:
//   __c4_*_overflow    : SIGNED (int/long, 32-bit two's complement) destination
//   __c4_u*_overflow   : UNSIGNED (unsigned/unsigned long, 32-bit) destination
// Each stores the (wrapped) 32-bit result through `res` and returns 1 iff the
// mathematical result does not fit the destination type's range, else 0.

// -- signed 32-bit destination --
// Sign helper: return 1 if the 32-bit value's bit 31 is set (negative), else 0.
int __c4_neg32(int v) {
    if (v & 0x80000000) { return 1; }
    return 0;
}

int __c4_add_overflow(int a, int b, int *res) {
    int s;
    int ov;
    s = a + b;                       // ALU masks to 32 bits
    *res = s;
    // signed overflow: operands same sign, result differs.
    ov = 0;
    if (__c4_neg32(a) == __c4_neg32(b) &&
        __c4_neg32(s) != __c4_neg32(a)) {
        ov = 1;
    }
    return ov;
}

int __c4_sub_overflow(int a, int b, int *res) {
    int s;
    int ov;
    s = a - b;
    *res = s;
    // signed overflow: operands differ in sign AND result sign differs from a.
    ov = 0;
    if (__c4_neg32(a) != __c4_neg32(b) &&
        __c4_neg32(s) != __c4_neg32(a)) {
        ov = 1;
    }
    return ov;
}

int __c4_mul_overflow(int a, int b, int *res) {
    int p;
    int ov;
    p = a * b;                       // low 32 bits of the product
    *res = p;
    ov = 0;
    if (a != 0) {
        // signed: reconstruct b from p/a (signed div); mismatch => overflow.
        if ((p / a) != b) {
            ov = 1;
        }
        // INT_MIN * -1 overflows but p/a round-trips; catch it explicitly.
        if (a == 0x80000000 && b == -1) { ov = 1; }
        if (b == 0x80000000 && a == -1) { ov = 1; }
    }
    return ov;
}

// -- unsigned 32-bit destination --
// unsigned add overflow: wrapped sum < a (carry out).  Uses the unsigned
// compare helper __ult (native32 provides it; fall back to sign-flip compare).
int __c4_uadd_overflow(int a, int b, int *res) {
    int s;
    s = a + b;
    *res = s;
    // carry: s < a as UNSIGNED.  Compare via bias by 0x80000000 (flip sign bit).
    if ((s ^ 0x80000000) < (a ^ 0x80000000)) { return 1; }
    return 0;
}

int __c4_usub_overflow(int a, int b, int *res) {
    int s;
    s = a - b;
    *res = s;
    // borrow: a < b as UNSIGNED.
    if ((a ^ 0x80000000) < (b ^ 0x80000000)) { return 1; }
    return 0;
}

int __c4_umul_overflow(int a, int b, int *res) {
    int p;
    p = a * b;
    *res = p;
    if (a == 0) { return 0; }
    // unsigned: p / a (unsigned div) must equal b.  Emulate unsigned division by
    // 32/32 long division is heavy; instead detect overflow via the high word.
    // p/a != b (unsigned) <=> overflow.  Use repeated-subtraction-free check:
    // overflow iff b != 0 and a > (0xffffffff / b) is hard without udiv; use the
    // sign-corrected quotient check for the common (both < 2^31) range and a
    // high-bit fallback.
    if (__c4_udiv(p, a) != b) { return 1; }
    return 0;
}

// unsigned 32-bit division (logical), for __c4_umul_overflow.  Shift-subtract.
int __c4_udiv(int a, int b) {
    int q;
    int r;
    int i;
    int bit;
    if (b == 0) { return 0; }
    q = 0;
    r = 0;
    i = 31;
    while (i >= 0) {
        r = (r << 1) & 0xffffffff;
        bit = (a >> i) & 1;
        r = r | bit;
        // compare r >= b as UNSIGNED
        if ((r ^ 0x80000000) >= (b ^ 0x80000000)) {
            r = r - b;
            q = q | ((1 << i) & 0xffffffff);
        }
        i = i - 1;
    }
    return q;
}
